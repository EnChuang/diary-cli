# =============================================================================
# 野史錄 Yes Log · 環境變數範本（可進 Git）
# =============================================================================
# 從 GitHub 複製專案後，請在本機執行：
#
#   copy .env.example .env
#
# 然後用編輯器打開 .env，把下面「你的金鑰」換成控制台的真 Key。
# .env 已在 .gitignore，請勿提交、勿貼到公開 Issue／聊天。
# =============================================================================

# —— 必填：ModelArk / 火山方舟 API Key（控制台顯示 ark-...）——
# 取得方式（擇一平台，以你帳號為準）：
#   BytePlus ModelArk：https://console.byteplus.com/  →  API Key
#   火山引擎方舟：控制台 → API Key 管理
ARK_API_KEY=ark-你的金鑰

# —— 可選：API 端點（預設為國際站示例，可依控制台改）——
# 國際 BytePlus 示例：
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# 中國火山示例（若你用大陸站，改成控制台給的 base）：
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# —— 可選：模型 ID 或推理接入點（須在控制台已開通）——
# 示例名稱，請改成你帳號可用的 model / endpoint id
ARK_MODEL=deepseek-v4-pro-260425
