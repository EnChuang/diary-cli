# 複製本檔為 .env 後填入金鑰（.env 勿提交 git）
# ModelArk API Key（控制台顯示 ark-...）
ARK_API_KEY=ark-你的金鑰
# BytePlus 國際：https://ark.ap-southeast.bytepluses.com/api/v3
# 火山引擎中國：https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# 控制台已開通的模型 ID 或推理接入點 ep-xxxxxxxx
ARK_MODEL=deepseek-v4-pro-260425
